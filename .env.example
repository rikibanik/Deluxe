# Database
DATABASE_URL=postgres://codehost:codehost@localhost:5432/codehost?sslmode=disable

# API
API_PORT=8080
JWT_SECRET=change-me-in-production
SESSION_TTL=168h

# Git HTTP
GIT_HTTP_PORT=9418
REPO_STORAGE_PATH=./storage/repos

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_GIT_HTTP_URL=http://localhost:9418

# Limits (MVP defaults)
MAX_REPO_SIZE_BYTES=524288000
MAX_FILE_SIZE_BYTES=52428800
MAX_REPOS_PER_USER=100
